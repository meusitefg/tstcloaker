# Supabase Configuration
# Crie seu projeto grátis em https://supabase.com
# Execute o SQL fornecido no README para criar a tabela 'links'
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Groq API Key (Opcional para análise de anúncio com IA em tempo real)
# Crie sua chave grátis em https://console.groq.com/keys
VITE_GROQ_API_KEY=
